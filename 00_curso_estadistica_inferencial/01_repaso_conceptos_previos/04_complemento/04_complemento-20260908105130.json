      "es_correcta": true
    },
    {
      "id_pregunta": 2,
      "enunciado": "El complemento del conjunto vacío es:",
      "opciones": [
        "a) El propio vacío",
        "b) El **conjunto universal** ($\\emptyset^c = \\Omega$)",
        "c) No existe",
        "d) Un conjunto con un elemento"
      ],
      "respuesta_correcta": "b) El **conjunto universal** ($\\emptyset^c = \\Omega$)",
      "respuesta_usuario": "b) El **conjunto universal** ($\\emptyset^c = \\Omega$)",
      "es_correcta": true
    },
    {
      "id_pregunta": 3,
      "enunciado": "La propiedad del doble complemento establece que:",
      "opciones": [
