    {
      "id_pregunta": 1,
      "enunciado": "Si $\\Omega = \\{1, 2, 3, 4, 5\\}$ y $A = \\{1, 2\\}$, entonces el complemento $A^c$ es:",
      "opciones": [
        "a) $\\{1, 2\\}$",
        "b) $\\{3, 4, 5\\}$",
        "c) $\\{1, 2, 3, 4, 5\\}$",
        "d) $\\emptyset$"
