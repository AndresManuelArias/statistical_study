        "c) $A^c = \\emptyset$",
        "d) $(A^c)^c = \\emptyset$"
      ],
      "respuesta_correcta": "a) $(A^c)^c = A$",
      "respuesta_usuario": "a) $(A^c)^c = A$",
      "es_correcta": true
    },
    {
      "id_pregunta": 4,
      "enunciado": "El complemento del conjunto universal es:",
