      "id_pregunta": 1,
      "enunciado": "¿Qué representa una combinación $C(n,r)$?",
      "opciones": [
        "a) El número de formas de ordenar los $n$ elementos del conjunto",
        "b) El número de formas de elegir $r$ elementos de $n$ elementos distintos donde el orden NO importa y no hay repetición",
        "c) El número de formas de elegir $r$ elementos de $n$ elementos distintos donde el orden sí importa",
        "d) El número de formas de elegir $r$ elementos permitiendo repetir cada elemento varias veces"
      ],
      "respuesta_correcta": "b) El número de formas de elegir $r$ elementos de $n$ elementos distintos donde el orden NO importa y no hay repetición",
      "respuesta_usuario": "b) El número de formas de elegir $r$ elementos de $n$ elementos distintos donde el orden NO importa y no hay repetición",
      "es_correcta": true
    },
    {
      "id_pregunta": 2,
      "enunciado": "¿Cuál es la fórmula correcta de una combinación $C(n,r)$?",
      "opciones": [
        "a) $C(n,r) = \\frac{n!}{r!\\,(n-r)!}$",
        "b) $C(n,r) = \\frac{n!}{r!}$",
        "c) $C(n,r) = \\frac{n!}{(n-r)!}$",
        "d) $C(n,r) = \\frac{r!}{n!\\,(n-r)!}$"
      ],
      "respuesta_correcta": "a) $C(n,r) = \\frac{n!}{r!\\,(n-r)!}$",
      "respuesta_usuario": "a) $C(n,r) = \\frac{n!}{r!\\,(n-r)!}$",
      "es_correcta": true
    },
