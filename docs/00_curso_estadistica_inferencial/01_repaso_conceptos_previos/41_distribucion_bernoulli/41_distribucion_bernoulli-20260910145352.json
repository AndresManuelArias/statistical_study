      "id_pregunta": 1,
      "enunciado": "¿Qué modela la distribución de Bernoulli?",
      "opciones": [
        "a) Varios ensayos independientes con más de dos resultados posibles",
        "b) Un único ensayo con exactamente dos resultados posibles: éxito o fracaso",
        "c) Una variable continua con distribución simétrica",
        "d) La suma de éxitos en múltiples ensayos independientes"
      ],
      "respuesta_correcta": "b) Un único ensayo con exactamente dos resultados posibles: éxito o fracaso",
      "respuesta_usuario": "b) Un único ensayo con exactamente dos resultados posibles: éxito o fracaso",
      "es_correcta": true
    },
    {
      "id_pregunta": 2,
      "enunciado": "En $X \\sim \\text{Bernoulli}(p)$, ¿qué representa el parámetro $p$?",
