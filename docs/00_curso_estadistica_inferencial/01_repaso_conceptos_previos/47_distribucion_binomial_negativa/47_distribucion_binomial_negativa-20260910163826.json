      "id_pregunta": 1,
      "enunciado": "¿Cuál es la función de masa de probabilidad de una distribución binomial negativa con parámetros $r$ y $p$?",
      "opciones": [
        "a) $P(X=k)=\\binom{k}{r} p^r (1-p)^k$",
        "b) $P(X=k)=\\binom{k-1}{r-1} p^r (1-p)^{k-r}$",
        "c) $P(X=k)=\\binom{k}{r-1} p^{r-1} (1-p)^{k-r}$",
        "d) $P(X=k)=\\binom{k-1}{r} p^{r+1} (1-p)^{k-r-1}$"
      ],
      "respuesta_correcta": "b) $P(X=k)=\\binom{k-1}{r-1} p^r (1-p)^{k-r}$",
      "respuesta_usuario": "b) $P(X=k)=\\binom{k-1}{r-1} p^r (1-p)^{k-r}$",
      "es_correcta": true
